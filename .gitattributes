# Normalize line endings: stored as LF in git, checked out as CRLF (DNN is a Windows platform)
* text=auto eol=crlf

*.resx text eol=crlf diff
*.dnn  text eol=crlf diff=html
*.txt  text eol=crlf
*.md   text eol=crlf
*.ps1  text eol=crlf
*.yml  text eol=lf
*.yaml text eol=lf

*.gif  binary
*.ico  binary
*.jpeg binary
*.jpg  binary
*.png  binary
*.zip  binary
