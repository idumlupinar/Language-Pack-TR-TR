  <data name="Prompt_PurgeModule_ResultHtml.Text" xml:space="preserve">
    <value>&lt;h4&gt;Belirli Bir Modülü Temizleme&lt;/h4&gt;
        &lt;p&gt;Aşağıdaki kod, Modül Kimliği (Module ID) 359 olan modülü temizler&lt;/p&gt;
        &lt;code class="block"&gt;purge-module 359 --pageid 20&lt;/code&gt;

        &lt;h4&gt;Sonuçlar&lt;/h4&gt;
        "359" kimlikli modül başarıyla temizlendi.</value>
  </data>
  <data name="Prompt_PurgePage_Description.Text" xml:space="preserve">
    <value>Daha önce silinip DNN Geri Dönüşüm Kutusuna gönderilmiş bir sayfayı siteden kalıcı olarak siler.</value>
  </data>
  <data name="Prompt_PurgePage_FlagDeleteChildren.Text" xml:space="preserve">
